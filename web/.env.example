# Server-only Supabase (never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session
AGENTTENDER_SESSION_COOKIE=agenttender_session
AGENTTENDER_SESSION_HOURS=8
AGENTTENDER_REMEMBER_ME_HOURS=720
AGENTTENDER_LOGIN_MAX_ATTEMPTS=5
AGENTTENDER_LOCK_MINUTES=15
AGENTTENDER_PASSWORD_RESET_MINUTES=60

# Initial admin seed (set real value only in web/.env.local)
AGENTTENDER_INITIAL_ADMIN_PASSWORD=
AGENTTENDER_FORCE_ADMIN_PASSWORD_RESET=false

# Legacy bootstrap (optional)
AGENTTENDER_BOOTSTRAP_ADMIN_EMAIL=
AGENTTENDER_BOOTSTRAP_ADMIN_NAME=
AGENTTENDER_BOOTSTRAP_ADMIN_PASSWORD=

NEXT_PUBLIC_APP_NAME=TenderFlow

# Document expiry warning window (days)
DOCUMENT_EXPIRY_SOON_DAYS=30

# SharePoint / Microsoft Graph credentials are NOT configured in Next.js.
# They are Supabase Edge Function secrets only. See supabase/.env.local.example.
# New tender artifact and manual tender uploads use the TenderDocs library.

# Server-only Power Automate emails (do not prefix with NEXT_PUBLIC_)
# Invite emails use POWER_AUTOMATE_EMAIL_URL.
# Password-reset emails use POWER_AUTOMATE_PASSWORD_RESET_EMAIL_URL when set,
# otherwise they fall back to POWER_AUTOMATE_EMAIL_URL.
POWER_AUTOMATE_EMAIL_URL=
POWER_AUTOMATE_PASSWORD_RESET_EMAIL_URL=
# Used by invite links and by the agent to POST /api/internal/ai-index-tender
# after Tender_All_Documents.zip upload (Bearer CRON_SECRET).
TENDERFLOW_APP_URL=http://localhost:3000

# Pending refund reminders (TF-55)
# Manual: Bid Fees page → "Send reminder"
# Cron: GET/POST /api/cron/pending-refund-reminders with Authorization: Bearer <CRON_SECRET>
# Schedule day/time via external cron (Vercel Cron, GitHub Actions, etc.) — not in-app.
CRON_SECRET=

# Explicit Tender247 API sync only. Nothing calls this automatically.
# POST /api/tender247/sync with Authorization: Bearer <TENDER247_SYNC_SECRET>
# Required mode: COMPATIBILITY_UNVERIFIED permits only the established,
# unfiltered gateway request shape. scrapedDate remains a processing label;
# the resulting feed is not verified date-complete or exhaustive. UNVERIFIED
# deliberately disables sync. VERIFIED requires provider evidence below.
TENDER247_UPSTREAM_CONTRACT_STATUS=COMPATIBILITY_UNVERIFIED
# Required only when status is VERIFIED. Example schema (do not copy values as
# provider facts): {"evidence":"provider-doc-url-or-case","dateFilter":{"field":"publication","timezone":"Asia/Kolkata","boundary":"INCLUSIVE_CALENDAR_DATE","startParam":"documented_from","endParam":"documented_to"},"pagination":{"mode":"PAGE_NUMBER","pageParam":"documented_page","pageSizeParam":"documented_page_size","pageSize":100,"firstPage":1,"totalCountField":"documented_total"}}
TENDER247_UPSTREAM_CONTRACT_JSON=
# Required secrets/configuration for manual or externally scheduled sync.
TENDER247_SYNC_SECRET=
# Azure gateway URL exactly ending in /api/tender247/tenders; no query string.
TENDER247_SYNC_ENDPOINT=
# Shared secret accepted by the Azure gateway (not the Tender247 provider token).
TENDER247_SYNC_UPSTREAM_SECRET=
# Canonical TenderFlow company UUID.
TENDER247_SYNC_COMPANY_ID=

# Required separate Tender247 mirror database (must not equal SUPABASE_URL).
# These tables are not in the canonical TenderFlow database: tender247_tenders
# and tender247_documents.
TENDER247_MIRROR_SUPABASE_URL=
TENDER247_MIRROR_SUPABASE_SERVICE_ROLE_KEY=

# No in-app Tender247 scheduler is enabled. Configure an external scheduler
# only after controlled smoke testing; its schedule/secret are optional.
# TENDER247_SYNC_SCHEDULER_ENABLED=false

# Ask AI / RAG (server-only; Phase 2 schema assumes these for Phase 3+)
# OPENAI_API_KEY is required for Ask AI and embeddings.
OPENAI_API_KEY=
# Chat model for Ask AI (falls back to OPENAI_TENDER_ASSESSMENT_MODEL / OPENAI_INGESTION_MODEL).
AI_CHAT_MODEL=
OPENAI_TENDER_ASSESSMENT_MODEL=
OPENAI_INGESTION_MODEL=
# Embedding model for agenttender_ai_document_chunks (must stay 1536-dim).
# Fixed contract: text-embedding-3-small → vector(1536). Do not change without a schema migration.
AI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: session token for CLI/background SharePoint indexing when cookies() is unavailable.
# AI_INDEX_SESSION_TOKEN=
# On-demand Ask AI indexing uses the authenticated session automatically when a user asks
# about an unindexed tender (Phase 3 pipeline; no request-time extraction for answers).

# Phase 8 production hardening
AI_RATE_LIMIT_USER_REQUESTS=20
AI_RATE_LIMIT_USER_WINDOW_SECONDS=300
AI_RATE_LIMIT_COMPANY_REQUESTS=100
AI_RATE_LIMIT_COMPANY_WINDOW_SECONDS=300
AI_MAX_CONCURRENT_PER_USER=1
AI_QUICK_ACTION_CACHE_TTL_SECONDS=21600
AI_RETRIEVAL_TIMEOUT_MS=20000
AI_MODEL_TIMEOUT_MS=90000
AI_MAX_QUESTION_CHARS=4000
AI_MAX_HISTORY_MESSAGES=8
AI_MAX_HISTORY_TOKENS=2000
AI_MAX_CONTEXT_TOKENS=5000
AI_MAX_OUTPUT_TOKENS=2500
# Approximate USD pricing per 1M tokens (estimated; used for internal cost tracking).
AI_CHAT_INPUT_COST_PER_MILLION=0.25
AI_CHAT_OUTPUT_COST_PER_MILLION=2.0
AI_EMBEDDING_COST_PER_MILLION=0.02
# Optional monthly company budget in USD (0 = disabled).
AI_COMPANY_MONTHLY_BUDGET_USD=0
# When true, include requestId/cacheHit in retrievalMeta for smoke/dev.
AI_ASK_DEV_META=false
