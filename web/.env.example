# Server-only Supabase (never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session
AGENTTENDER_SESSION_COOKIE=agenttender_session
AGENTTENDER_SESSION_HOURS=8
AGENTTENDER_REMEMBER_ME_HOURS=720
AGENTTENDER_LOGIN_MAX_ATTEMPTS=5
AGENTTENDER_LOCK_MINUTES=15
AGENTTENDER_PASSWORD_RESET_MINUTES=60

# Initial admin seed (set real value only in web/.env.local)
AGENTTENDER_INITIAL_ADMIN_PASSWORD=
AGENTTENDER_FORCE_ADMIN_PASSWORD_RESET=false

# Legacy bootstrap (optional)
AGENTTENDER_BOOTSTRAP_ADMIN_EMAIL=
AGENTTENDER_BOOTSTRAP_ADMIN_NAME=
AGENTTENDER_BOOTSTRAP_ADMIN_PASSWORD=

NEXT_PUBLIC_APP_NAME=TenderFlow

# Document expiry warning window (days)
DOCUMENT_EXPIRY_SOON_DAYS=30

# SharePoint / Microsoft Graph credentials are NOT configured in Next.js.
# They are Supabase Edge Function secrets only. See supabase/.env.local.example.
# New tender artifact and manual tender uploads use the TenderDocs library.

# Server-only Power Automate emails (do not prefix with NEXT_PUBLIC_)
# Invite emails use POWER_AUTOMATE_EMAIL_URL.
# Password-reset emails use POWER_AUTOMATE_PASSWORD_RESET_EMAIL_URL when set,
# otherwise they fall back to POWER_AUTOMATE_EMAIL_URL.
POWER_AUTOMATE_EMAIL_URL=
POWER_AUTOMATE_PASSWORD_RESET_EMAIL_URL=
TENDERFLOW_APP_URL=http://localhost:3000

# Pending refund reminders (TF-55)
# Manual: Bid Fees page → "Send reminder"
# Cron: GET/POST /api/cron/pending-refund-reminders with Authorization: Bearer <CRON_SECRET>
# Schedule day/time via external cron (Vercel Cron, GitHub Actions, etc.) — not in-app.
CRON_SECRET=
