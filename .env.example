HEADLESS=false
TENDER247_ENABLED=true
BIDASSIST_ENABLED=false
TENDER247_URL=https://www.tender247.com/auth/tender
DOWNLOAD_ROOT=./downloads
LOG_ROOT=./logs
SCREENSHOT_ROOT=./screenshots
DOWNLOAD_TIMEOUT_MS=120000
PAGE_TIMEOUT_MS=90000
MAX_RETRIES=2

# Detail crawl settings
TENDER_DETAIL_CONCURRENCY=2
TENDER_DETAIL_MAX_RETRIES=2
# 0 = UNLIMITED (crawl all tenders for the daily run). Positive N = at most N.
MAX_TENDERS=0
DOWNLOAD_ALL_DOCUMENTS_TOO=false

# Used only when Tender247 shows the real LOGIN modal on a detail page.
# Keep these in local .env only — never commit credentials.
TENDER247_EMAIL=
TENDER247_PASSWORD=

# ChatGPT qualification
# 0 = UNLIMITED (every PASSED + chatgpt_eligible tender). Positive N = at most N GPT submissions.
# Rejected / MANUAL_REVIEW never count against this limit.
MAX_GPT_TENDERS=0
CHATGPT_MIN_SUBMISSION_INTERVAL_MS=600000

# BidAssist crawler
# 0 = UNLIMITED after Software and IT Solutions + opening-date filters. Positive N = at most N.
MAX_BIDASSIST_TENDERS=0

# Deterministic pre-screening (before ChatGPT)
PRESCREEN_ENABLED=true
PRESCREEN_TENDER_VALUE_MAX_INR=50000000
PRESCREEN_TENDER247_EMD_MAX_INR=1500000
PRESCREEN_MIN_LEAD_DAYS=1
PRESCREEN_TENDER247_REQUIRE_IT_RELEVANCE=true
PRESCREEN_BIDASSIST_REQUIRE_IT_RELEVANCE=false
PRESCREEN_RULES_VERSION=2026-08-06-v2
PRESCREEN_TIMEZONE=Asia/Kolkata
