HEADLESS=false
TENDER247_ENABLED=true
BIDASSIST_ENABLED=false
TENDER247_URL=https://www.tender247.com/auth/tender
DOWNLOAD_ROOT=./downloads
LOG_ROOT=./logs
SCREENSHOT_ROOT=./screenshots
DOWNLOAD_TIMEOUT_MS=120000
PAGE_TIMEOUT_MS=90000
MAX_RETRIES=2

# Detail crawl settings
TENDER_DETAIL_CONCURRENCY=2
TENDER_DETAIL_MAX_RETRIES=2
# 0 = UNLIMITED (crawl all tenders for the daily run). Positive N = at most N.
MAX_TENDERS=0
DOWNLOAD_ALL_DOCUMENTS_TOO=false

# Tender247 logins for ONE company (Siyana). Put both accounts here.
# Without --account-id, pipeline runs ALL configured accounts in order (1 then 2).
# Use --account-id=1 or --account-id=2 to run only one.
TENDER247_ACCOUNT=1

TENDER247_ACCOUNT_1_LABEL=Main Account
TENDER247_ACCOUNT_1_EMAIL=
TENDER247_ACCOUNT_1_PASSWORD=

TENDER247_ACCOUNT_2_LABEL=Backup Account
TENDER247_ACCOUNT_2_EMAIL=
TENDER247_ACCOUNT_2_PASSWORD=

# Optional aliases for account 1 (same as ACCOUNT_1_* if those are empty)
TENDER247_EMAIL=
TENDER247_PASSWORD=

# Optional: company id (defaults to Siyana)
# COMPANY_ID=a1b2c3d4-e5f6-7890-abcd-ef1234567890
# Optional: DB account UUID instead of env slot 1|2
# TENDER247_ACCOUNT_ID=
# CREDENTIALS_ENCRYPTION_KEY=

# Persistent ChatGPT chat for daily Tender247 Excel screening (same link every day)
# Share or conversation URL — e.g. https://chatgpt.com/share/...
# Writable daily screening chat (/c/ or /g/.../c/) — not Project Home, not /share/
CHATGPT_SCREENING_CHAT_URL=https://chatgpt.com/g/g-p-6a6af1fde80c8191a7b497acfa2e0755/c/6a8d22d3-d898-83ee-9576-1a1330f31467

# Power Automate daily screening notification (dynamic subject + body only)
# Schema for the HTTP trigger: src/notify/powerAutomateEmail.schema.json
# After GPT screened Excel + Supabase upsert (also on failure / web-vs-Excel count mismatch)
# Off by default — set POWER_AUTOMATE_EMAIL_ENABLED=true when you want emails sent
POWER_AUTOMATE_EMAIL_ENABLED=false
POWER_AUTOMATE_EMAIL_URL=

# Skip Tender247 per-tender detail crawl (docs/AI Summary) after Phase-1 screening
# SKIP_DETAIL_CRAWL=true

# Prefer today's `{DD-MM-YY}_daily Tenders.xlsx` from the shared ChatGPT chat when
# present. If scrolling finds only an *older* daily Excel, today's file is missing
# and the pipeline prompts ChatGPT to generate a new one (seamless).
# CHATGPT_SCREENING_REUSE_EXISTING_ONLY is legacy and no longer blocks generation.


# ChatGPT qualification
# 0 = UNLIMITED (every PASSED + chatgpt_eligible tender). Positive N = at most N GPT submissions.
# Rejected / MANUAL_REVIEW never count against this limit.
MAX_GPT_TENDERS=0
CHATGPT_MIN_SUBMISSION_INTERVAL_MS=600000
# Experimental: extract Tender_All_Documents.zip text and qualify via prompt only (no ZIP upload).
# Blank DOCUMENT_TEXT_TEST_TENDER_IDS = all ZIP-ready tenders under downloads/{date}.
# Optional subset filter: ["T247-103544061","T247-103544074"]
DOCUMENT_TEXT_MODE=false
DOCUMENT_TEXT_TEST_TENDER_IDS=
# Max chars of compressed document context embedded in the ChatGPT prompt
MAX_DOCUMENT_CONTEXT_CHARACTERS=50000
# Prompt-only path: no ZIP upload buffer between tenders (default 0)
# CHATGPT_DOCUMENT_TEXT_MIN_SEND_INTERVAL_MS=0
# Internal rolling-window safety (NEW detailed sends only; shared by pipeline + text-mode)
CHATGPT_DETAIL_MAX_SUBMISSIONS_PER_WINDOW=65
CHATGPT_DETAIL_SUBMISSION_WINDOW_MINUTES=180
CHATGPT_DETAIL_RATE_SAFETY_BUFFER_SECONDS=60

# BidAssist crawler
# 0 = UNLIMITED after Software and IT Solutions + opening-date filters. Positive N = at most N.
MAX_BIDASSIST_TENDERS=0

# Deterministic pre-screening (before ChatGPT)
PRESCREEN_ENABLED=true
PRESCREEN_TENDER_VALUE_MAX_INR=50000000
PRESCREEN_TENDER247_EMD_MAX_INR=1500000
PRESCREEN_MIN_LEAD_DAYS=1
PRESCREEN_TENDER247_REQUIRE_IT_RELEVANCE=true
PRESCREEN_BIDASSIST_REQUIRE_IT_RELEVANCE=false
PRESCREEN_RULES_VERSION=2026-08-06-v2
PRESCREEN_TIMEZONE=Asia/Kolkata
