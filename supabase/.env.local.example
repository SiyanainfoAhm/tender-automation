# Tender Automation — local Edge Function secrets
# Copy to supabase/.env.local (gitignored). Never commit real values.
# Production: set these with `supabase secrets set ...`

TENDER_AUTOMATION_AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
TENDER_AUTOMATION_AZURE_STORAGE_CONTAINER_NAME=companydocuments
TENDER_AUTOMATION_AZURE_STORAGE_SAS_TOKEN=?sv=...
