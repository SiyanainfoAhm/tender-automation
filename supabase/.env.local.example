# Tender Automation — local Edge Function secrets
# Copy to supabase/.env.local (gitignored). Never commit real values.
# Production: set these with `supabase secrets set ...`

# Microsoft Graph application credentials. Prefer Sites.Selected application
# permission with write access granted only to SiyanaTenderDocumentRepository.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_HOSTNAME=it1stop.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/SiyanaTenderDocumentRepository
SHAREPOINT_LIBRARY_NAME=TenderDocs
SHAREPOINT_TENDER_ARTIFACT_ROOT=companies/siyana-info-solutions-pvt-ltd_a1b2c3d4-e5f6-7890-abcd-ef1234567890/tender-artifacts

# Legacy Azure secrets are required only while non-tender company documents
# and existing Azure rows remain in use. New agent/manual tender uploads do not
# use Azure or SAS.
TENDER_AUTOMATION_AZURE_STORAGE_ACCOUNT_NAME=
TENDER_AUTOMATION_AZURE_STORAGE_CONTAINER_NAME=companydocuments
TENDER_AUTOMATION_AZURE_STORAGE_SAS_TOKEN=
TENDER_AUTOMATION_AZURE_STORAGE_ACCOUNT_KEY=
